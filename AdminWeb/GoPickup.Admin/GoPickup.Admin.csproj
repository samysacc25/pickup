  <ItemGroup>
    <ProjectReference Include="..\..\Backend\GoPickup.API\GoPickup.API.csproj">
      <ExcludeAssets>contentFiles</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
